# Only the selected cloud provider's key is required.
ANTHROPIC_API_KEY=your-api-key-here
# OpenRouter: set this key, then choose OpenRouter in the plugin's AI provider setting.
# OPENROUTER_API_KEY=your-openrouter-key-here

# Optional Antigravity subscription provider (macOS only; never uses API keys)
# ANTIGRAVITY_CLI_PATH=/Users/yourname/.local/bin/agy
# ANTIGRAVITY_TIMEOUT_SECONDS=600
# ANTIGRAVITY_VAULT_PATHS=/absolute/path/to/Obsidian/vault

# Optional: OpenAI-compatible local LLM server (MLX Core / mlx_lm.server / LM Studio)
# LOCAL_LLM_URL=http://127.0.0.1:11234
# LOCAL_LLM_MODELS_DIR=~/.mlx-serve/models
# Optional: cap the context window (tokens) used for local models, e.g. to limit RAM use
# LOCAL_LLM_MAX_CONTEXT=8192
